<%- include('partials/header') %>

<section class="blog-hero">
    <h1>Welcome to My Blog Space</h1>
    <p>A minimalist destination for technical thoughts.</p>
</section>

<div class="posts-feed-container">
    
    <% if (blogPosts.length === 0) { %>
        <div class="no-posts-alert">
            <p>Your feed is completely empty right now.</p>
        </div>
    <% } else { %>
        
        <% blogPosts.forEach(function(post) { %>
            <article class="blog-post-card">
                <h2><%= post.title %></h2>
                <p><%= post.content %></p>
                
                <div class="post-actions">
                    <a href="/posts/<%= post.id %>/edit" class="btn-edit">Edit</a>
                    
                    <form action="/posts/<%= post.id %>/delete" method="POST" style="display: inline;">
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                </div>
            </article>
        <% }); %>

    <% } %>

</div>

<%- include('partials/footer') %>